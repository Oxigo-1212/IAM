# PostgreSQL
POSTGRES_DB=iam_service
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/iam_service
DB_USERNAME=iam_user
DB_PASSWORD=iam_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (must be at least 32 bytes for HS256; replace in production)
JWT_SECRET=change-this-development-secret-key-at-least-32-bytes-long

# Gmail SMTP (enable 2-Step Verification and generate a 16-char Google App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-google-app-password
MAIL_FROM=your-email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
